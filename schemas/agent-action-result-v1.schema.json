  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "request_validation"}}, "required": ["phase"]},
      "then": {"properties": {
        "evidence": {"allOf": [
          {"not": {"required": ["acquisition_receipt"]}},
          {"not": {"required": ["dwd_metadata_receipt"]}},
          {"not": {"required": ["efehr_readme_receipt"]}},
          {"not": {"required": ["efehr_eshm20_tree_metadata"]}}
        ]}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "request_validation"}, "status": {"const": "pass"}}, "required": ["phase", "status"]},
      "then": {"properties": {
        "evidence": {"properties": {"ledger_scan_complete": {"const": true}, "prior_result_reused": {"const": false}}},
        "duplicate_result_comment_id": {"type": "null"}, "failure_class": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"status": {"const": "duplicate"}}, "required": ["status"]},
      "then": {"properties": {
        "phase": {"const": "request_validation"},
        "evidence": {"properties": {"ledger_scan_complete": {"const": true}, "prior_result_reused": {"const": true}}},
        "duplicate_result_comment_id": {"type": "integer", "minimum": 1}, "failure_class": {"const": "duplicate_request"}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "request_validation"}, "status": {"const": "blocked"}}, "required": ["phase", "status"]},
      "then": {"properties": {
        "evidence": {"properties": {"ledger_scan_complete": {"const": false}, "prior_result_reused": {"const": false}}},
        "duplicate_result_comment_id": {"type": "null"}, "failure_class": {"const": "ledger_incomplete"}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "acquisition_receipt"}}, "required": ["phase"]},
      "then": {"properties": {
        "action": {"enum": ["acquisition_receipt", "dwd_metadata_receipt", "efehr_readme_receipt", "efehr_eshm20_tree_metadata"]},
        "duplicate_result_comment_id": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "acquisition_receipt"}, "action": {"const": "acquisition_receipt"}}, "required": ["phase", "action"]},
      "then": {"properties": {
        "source_issue": {"const": 162},
        "dataset_id": {"const": "dwd.cdc.obsgermany-climate-10min-extreme-wind.v24.03"},
        "evidence": {"required": ["acquisition_receipt"]}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "acquisition_receipt"}, "action": {"const": "dwd_metadata_receipt"}}, "required": ["phase", "action"]},
      "then": {"properties": {
        "source_issue": {"const": 211},
        "dataset_id": {"const": "dwd.cdc.obsgermany-climate-10min-extreme-wind.v24.03"},
        "evidence": {"required": ["dwd_metadata_receipt"]}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "acquisition_receipt"}, "action": {"const": "efehr_readme_receipt"}}, "required": ["phase", "action"]},
      "then": {"properties": {
        "source_issue": {"const": 298},
        "dataset_id": {"const": "efehr.esrm20.european-exposure-model.v1.0"},
        "evidence": {"required": ["efehr_readme_receipt"]}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "acquisition_receipt"}, "action": {"const": "efehr_eshm20_tree_metadata"}}, "required": ["phase", "action"]},
      "then": {"properties": {
        "source_issue": {"const": 332},
        "dataset_id": {"const": "efehr.eshm20"},
        "evidence": {"required": ["efehr_eshm20_tree_metadata"]}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "acquisition_receipt"}, "action": {"const": "acquisition_receipt"}, "status": {"const": "pass"}}, "required": ["phase", "action", "status"]},
      "then": {"properties": {
        "evidence": {"properties": {"acquisition_receipt": {"$ref": "#/$defs/acquisitionReceipt"}}},
        "failure_class": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "acquisition_receipt"}, "action": {"const": "dwd_metadata_receipt"}, "status": {"const": "pass"}}, "required": ["phase", "action", "status"]},
      "then": {"properties": {
        "evidence": {"properties": {"dwd_metadata_receipt": {"$ref": "#/$defs/dwdMetadataReceipt"}}},
        "failure_class": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "acquisition_receipt"}, "action": {"const": "efehr_readme_receipt"}, "status": {"const": "pass"}}, "required": ["phase", "action", "status"]},
      "then": {"properties": {
        "evidence": {"properties": {"efehr_readme_receipt": {"$ref": "#/$defs/efehrReadmeReceipt"}}},
        "failure_class": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "acquisition_receipt"}, "action": {"const": "efehr_eshm20_tree_metadata"}, "status": {"const": "pass"}}, "required": ["phase", "action", "status"]},
      "then": {"properties": {
        "evidence": {"properties": {"efehr_eshm20_tree_metadata": {"$ref": "#/$defs/efehrEshm20TreeMetadata"}}},
        "failure_class": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "acquisition_receipt"}, "action": {"const": "acquisition_receipt"}, "status": {"const": "blocked"}}, "required": ["phase", "action", "status"]},
      "then": {"properties": {
        "evidence": {"properties": {"acquisition_receipt": {"type": "null"}}},
        "failure_class": {"const": "acquisition_failed"}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "acquisition_receipt"}, "action": {"const": "dwd_metadata_receipt"}, "status": {"const": "blocked"}}, "required": ["phase", "action", "status"]},
      "then": {"properties": {
        "evidence": {"properties": {"dwd_metadata_receipt": {"type": "null"}}},
        "failure_class": {"const": "acquisition_failed"}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "acquisition_receipt"}, "action": {"const": "efehr_readme_receipt"}, "status": {"const": "blocked"}}, "required": ["phase", "action", "status"]},
      "then": {"properties": {
        "evidence": {"properties": {"efehr_readme_receipt": {"type": "null"}}},
        "failure_class": {"const": "acquisition_failed"}
      }}
    },
    {
      "if": {"properties": {"phase": {"const": "acquisition_receipt"}, "action": {"const": "efehr_eshm20_tree_metadata"}, "status": {"const": "blocked"}}, "required": ["phase", "action", "status"]},
      "then": {"properties": {
        "evidence": {"properties": {"efehr_eshm20_tree_metadata": {"type": "null"}}},
        "failure_class": {"const": "acquisition_failed"}
      }}
    }
  ]
}
