{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pokekarten/OpenCatastrophe-data/blob/main/schemas/transformation-contract-v0.schema.json",
  "title": "OpenCatastrophe-data transformation contract v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "mapping_id",
    "mapping_version",
    "source_profile",
    "target_profile",
    "rules",
    "unsupported_fields",
    "semantics",
    "reconciliation_checks"
  ],
  "properties": {
    "profile_version": {"const": "0.1.0"},
    "mapping_id": {"$ref": "#/$defs/id"},
    "mapping_version": {"$ref": "#/$defs/version"},
    "source_profile": {"$ref": "#/$defs/profile"},
    "target_profile": {"$ref": "#/$defs/profile"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/copy_rule"},
          {"$ref": "#/$defs/rename_rule"},
          {"$ref": "#/$defs/code_map_rule"},
          {"$ref": "#/$defs/unit_conversion_rule"}
        ]
      }
    },
    "unsupported_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/field"}
    },
    "semantics": {"$ref": "#/$defs/semantics"},
    "reconciliation_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reconciliation_check"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "field": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lossy", "notes"],
      "properties": {
        "lossy": {"type": "boolean"},
        "notes": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "copy_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "operation", "source_field", "target_field", "lossy", "reversible"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "operation": {"const": "copy"},
        "source_field": {"$ref": "#/$defs/field"},
        "target_field": {"$ref": "#/$defs/field"},
        "lossy": {"type": "boolean"},
        "reversible": {"type": "boolean"}
      }
    },
    "rename_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "operation", "source_field", "target_field", "lossy", "reversible"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "operation": {"const": "rename"},
        "source_field": {"$ref": "#/$defs/field"},
        "target_field": {"$ref": "#/$defs/field"},
        "lossy": {"type": "boolean"},
        "reversible": {"type": "boolean"}
      }
    },
    "code_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "minLength": 1, "maxLength": 256},
        "to": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "code_map_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "operation", "source_field", "target_field", "lossy", "reversible", "mapping"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "operation": {"const": "code_map"},
        "source_field": {"$ref": "#/$defs/field"},
        "target_field": {"$ref": "#/$defs/field"},
        "lossy": {"type": "boolean"},
        "reversible": {"type": "boolean"},
        "mapping": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/code_pair"}}
      }
    },
    "unit_conversion_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "operation", "source_field", "target_field", "lossy", "reversible", "from_unit", "to_unit", "factor", "offset"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "operation": {"const": "unit_conversion"},
        "source_field": {"$ref": "#/$defs/field"},
        "target_field": {"$ref": "#/$defs/field"},
        "lossy": {"type": "boolean"},
        "reversible": {"type": "boolean"},
        "from_unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "to_unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "factor": {"type": "number"},
        "offset": {"type": "number"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {"enum": ["equal", "absolute_tolerance"]},
        "tolerance": {"type": "number", "minimum": 0}
      }
    },
    "reconciliation_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "metric", "group_by", "comparison"],
      "properties": {
        "check_id": {"$ref": "#/$defs/id"},
        "metric": {"enum": ["count", "sum", "null_count", "unique_count"]},
        "field": {"$ref": "#/$defs/field"},
        "group_by": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/field"}},
        "comparison": {"$ref": "#/$defs/comparison"}
      }
    }
  }
}
