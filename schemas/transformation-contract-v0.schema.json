{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencatastrophe:schema:transformation-contract:0.1.0",
  "title": "OpenCatastrophe-data transformation contract v0",
  "description": "Closed structural contract. Full semantic acceptance additionally requires scripts/validate_transformation_contract.py for cross-field and cross-record invariants that JSON Schema cannot express portably.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "mapping_id",
    "mapping_version",
    "source_profile",
    "target_profile",
    "rules",
    "unsupported_fields",
    "semantics",
    "reconciliation_checks"
  ],
  "properties": {
    "profile_version": {"const": "0.1.0"},
    "mapping_id": {"$ref": "#/$defs/id"},
    "mapping_version": {"$ref": "#/$defs/version"},
    "source_profile": {"$ref": "#/$defs/profile"},
    "target_profile": {"$ref": "#/$defs/profile"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/copy_rule"},
          {"$ref": "#/$defs/rename_rule"},
          {"$ref": "#/$defs/code_map_rule"},
          {"$ref": "#/$defs/unit_conversion_rule"}
        ]
      }
    },
    "unsupported_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/field"}
    },
    "semantics": {"$ref": "#/$defs/semantics"},
    "reconciliation_checks": {
      "description": "Pre-declared source-to-target reconciliation checks. Source records are interpreted through the declared rules into target-space semantics before comparison; field and group_by therefore name projected target fields.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reconciliation_check"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^\\S(?:.*\\S)?$",
      "not": {"pattern": "^[Ll][Aa][Tt][Ee][Ss][Tt]$"}
    },
    "field": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lossy", "notes"],
      "properties": {
        "lossy": {"type": "boolean"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "copy_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "operation", "source_field", "target_field", "lossy", "reversible"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "operation": {"const": "copy"},
        "source_field": {"$ref": "#/$defs/field"},
        "target_field": {"$ref": "#/$defs/field"},
        "lossy": {"type": "boolean"},
        "reversible": {"type": "boolean"}
      },
      "allOf": [
        {"not": {"properties": {"lossy": {"const": true}, "reversible": {"const": true}}, "required": ["lossy", "reversible"]}}
      ]
    },
    "rename_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "operation", "source_field", "target_field", "lossy", "reversible"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "operation": {"const": "rename"},
        "source_field": {"$ref": "#/$defs/field"},
        "target_field": {"$ref": "#/$defs/field"},
        "lossy": {"type": "boolean"},
        "reversible": {"type": "boolean"}
      },
      "allOf": [
        {"not": {"properties": {"lossy": {"const": true}, "reversible": {"const": true}}, "required": ["lossy", "reversible"]}}
      ]
    },
    "code_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1}
      }
    },
    "code_map_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "operation", "source_field", "target_field", "lossy", "reversible", "mapping"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "operation": {"const": "code_map"},
        "source_field": {"$ref": "#/$defs/field"},
        "target_field": {"$ref": "#/$defs/field"},
        "lossy": {"type": "boolean"},
        "reversible": {"type": "boolean"},
        "mapping": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/code_pair"}}
      },
      "allOf": [
        {"not": {"properties": {"lossy": {"const": true}, "reversible": {"const": true}}, "required": ["lossy", "reversible"]}}
      ]
    },
    "unit_conversion_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "operation", "source_field", "target_field", "lossy", "reversible", "from_unit", "to_unit", "factor", "offset"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "operation": {"const": "unit_conversion"},
        "source_field": {"$ref": "#/$defs/field"},
        "target_field": {"$ref": "#/$defs/field"},
        "lossy": {"type": "boolean"},
        "reversible": {"type": "boolean"},
        "from_unit": {"type": "string", "minLength": 1},
        "to_unit": {"type": "string", "minLength": 1},
        "factor": {"type": "number", "not": {"const": 0}},
        "offset": {"type": "number"}
      },
      "allOf": [
        {"not": {"properties": {"lossy": {"const": true}, "reversible": {"const": true}}, "required": ["lossy", "reversible"]}}
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {"enum": ["equal", "absolute_tolerance"]},
        "tolerance": {"type": "number", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "equal"}}, "required": ["method"]},
          "then": {"not": {"required": ["tolerance"]}}
        },
        {
          "if": {"properties": {"method": {"const": "absolute_tolerance"}}, "required": ["method"]},
          "then": {"required": ["tolerance"]}
        }
      ]
    },
    "reconciliation_check": {
      "description": "A source-to-target check expressed in projected target-space semantics. The declared transformation rules define how source fields, codes, and units are projected before comparison; field and group_by refer to those projected target fields.",
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "metric", "group_by", "comparison"],
      "properties": {
        "check_id": {"$ref": "#/$defs/id"},
        "metric": {"enum": ["count", "sum", "null_count", "unique_count"]},
        "field": {"$ref": "#/$defs/field"},
        "group_by": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/field"}},
        "comparison": {"$ref": "#/$defs/comparison"}
      },
      "allOf": [
        {
          "if": {"properties": {"metric": {"const": "count"}}, "required": ["metric"]},
          "then": {"not": {"required": ["field"]}}
        },
        {
          "if": {"properties": {"metric": {"enum": ["sum", "null_count", "unique_count"]}}, "required": ["metric"]},
          "then": {"required": ["field"]}
        }
      ]
    }
  }
}
